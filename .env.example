NODE_ENV=development
PORT=3000
DATABASE_PATH=data/vehicles.sqlite
DATABASE_SYNCHRONIZE=true
LOG_LEVEL=info
NHTSA_ALL_MAKES_URL=https://vpic.nhtsa.dot.gov/api/vehicles/getallmakes?format=XML
NHTSA_VEHICLE_TYPES_URL_TEMPLATE=https://vpic.nhtsa.dot.gov/api/vehicles/GetVehicleTypesForMakeId/{makeId}?format=xml
HTTP_TIMEOUT_MS=10000
INGESTION_CONCURRENCY=8
INGESTION_BATCH_SIZE=250
INGESTION_MAX_MAKES=0
INGEST_ON_STARTUP=false
